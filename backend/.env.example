# oc-controller backend — copy to .env (never commit .env)

DATABASE_URL=postgresql://occontroller:occontroller@127.0.0.1:25432/oc_controller

JWT_SECRET=dev-jwt-secret-change-me
JWT_ACCESS_TTL_SEC=900
# Portal session: persisted in DB across restarts until logout or expiry (default 30d; slides on refresh)
JWT_REFRESH_TTL_SEC=2592000
# Required: 32-byte hex — openssl rand -hex 32
CHAT_ENCRYPTION_KEY=
REFRESH_TOKEN_PEPPER=

# Default portal admin (created once by npm run db:seed if no user with this email exists)
ADMIN_EMAIL=admin@localhost
ADMIN_PASSWORD=changeme

OC_CONTROLLER_SECRET=
OP_CONTROLLER_DEFAULT_HOST=host.docker.internal
OC_CONTROLLER_APP_PORT=3800

FLEET_CHAT_MODEL=openai/gpt-4o-mini
# Fallback gateway token when instance has none (prefer per-instance gateway_token or OC_<SLUG>_GATEWAY_TOKEN)
OPENCLAW_GATEWAY_TOKEN=
# Example per-instance: OC_ALPHA_GATEWAY_TOKEN=...
OPENAI_API_KEY=
TWILIO_BRIDGE_INTERNAL_URL=http://127.0.0.1:5080
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_VERIFY_SERVICE_SID=

# Optional agent-gateway host used by `npm run db:seed-demo`
OC_GATEWAY_HOST=127.0.0.1
OC_GATEWAY_HOST_FALLBACK=
# Agent workspace trees (SOUL.md, skills, custom prompts) — keep outside git
OC_WORKSPACE_ROOT=
SPEACHES_URL=http://127.0.0.1:8090
FISH_API_KEY=
# Optional Fish reference_id when an avatar has no voice configured
FISH_DEFAULT_VOICE_ID=
# Optional per-slug keys at seed: OC_ALPHA_API_KEY=...

# VRM library: directory-backed meshes + uploaded files (not stored in Postgres)
OC_VRM_DIR=data/vrm-library
OC_VRM_UPLOAD_DIR=data/vrm-uploads
# Default 64 MiB
OC_VRM_MAX_BYTES=67108864

LOG_LEVEL=info
# Console HTTP: quiet (4xx/5xx only) | all | off
HTTP_ACCESS_CONSOLE=quiet
AUDIT_LOG_ENABLED=true
AUDIT_LOG_DIR=data/audit
AUDIT_LOG_RETENTION_DAYS=30
HEALTH_PING_INTERVAL_MS=60000
